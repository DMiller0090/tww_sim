#!/usr/bin/env bash
# Tracked pre-commit hook. Enable once per clone with:
#   git config core.hooksPath .githooks
# Bypass a genuine exception with: git commit --no-verify
set -uo pipefail
root="$(git rev-parse --show-toplevel)"

# 1. Comment-length style gate (see .githooks/check-comment-length.sh).
bash "$root/.githooks/check-comment-length.sh" || exit 1

# 2. Knowledge-base doc gate: structure/link hygiene + stale-Source detection.
bash "$root/.githooks/kb-doc-gate.sh" || exit 1

# 3. Code hygiene gate: no stale superswim.* refs; no oversized module (see check-code-hygiene.sh).
bash "$root/.githooks/check-code-hygiene.sh" || exit 1

# 4. Seam-clip status gate: harness/rollstab/*.py changes must update the README ## Status.
bash "$root/.githooks/check-rollstab-status.sh" || exit 1
